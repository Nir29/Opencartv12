<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

  <!-- Define properties -->
  <Properties>
    <Property name="basePath">./logs</Property>
  </Properties>

  <Appenders>
    <!-- Console Appender -->
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>

    <!-- Rolling File Appender with improved properties -->
    <RollingFile name="File" fileName="${basePath:-./logs}/automation.log" 
                 filePattern="${basePath:-./logs}/automation-%d{yyyy-MM-dd}.log.gz">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="10MB"/>
      </Policies>
      <DefaultRolloverStrategy max="10"/>
    </RollingFile>

  </Appenders>

  <Loggers>
    <!-- Root logger references both console and rolling appenders -->
    <Root level="debug">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>

</Configuration>
